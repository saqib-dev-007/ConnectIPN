<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_bg"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="18dp"
        android:paddingBottom="20dp">

        <!-- Connection panel: radar + live state + actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_panel"
            android:orientation="vertical"
            android:padding="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.connectipn.RadarView
                    android:id="@+id/statusDot"
                    android:layout_width="54dp"
                    android:layout_height="54dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/statusText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:letterSpacing="-0.01"
                        android:text="@string/status_idle"
                        android:textColor="@color/ui_text"
                        android:textSize="19sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/detailText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:lineSpacingExtra="3dp"
                        android:text="@string/detail_idle"
                        android:textColor="@color/ui_text_muted"
                        android:textSize="12.5sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/rootText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:fontFamily="monospace"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/ui_text_dim"
                android:textSize="11sp" />

            <Button
                android:id="@+id/scanButton"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_primary"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.01"
                android:stateListAnimator="@null"
                android:text="@string/action_scan"
                android:textAllCaps="false"
                android:textColor="@color/ui_on_accent"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/permissionButton"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_row"
                    android:fontFamily="sans-serif-medium"
                    android:stateListAnimator="@null"
                    android:text="@string/action_permission"
                    android:textAllCaps="false"
                    android:textColor="@color/ui_text_muted"
                    android:textSize="12.5sp" />

                <Button
                    android:id="@+id/disconnectButton"
                    android:layout_width="0dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_row"
                    android:enabled="false"
                    android:fontFamily="sans-serif-medium"
                    android:stateListAnimator="@null"
                    android:text="@string/action_disconnect"
                    android:textAllCaps="false"
                    android:textColor="@color/ui_text_muted"
                    android:textSize="12.5sp" />
            </LinearLayout>

            <!-- Transport: plain Wi-Fi, or the cable when adb is available -->
            <Switch
                android:id="@+id/usbSwitch"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_row"
                android:fontFamily="sans-serif-medium"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:text="@string/action_usb_switch"
                android:textAllCaps="false"
                android:textColor="@color/ui_text_muted"
                android:textSize="12.5sp" />
        </LinearLayout>

        <!-- Command deck -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="22dp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.14"
            android:text="@string/apps_title"
            android:textAllCaps="true"
            android:textColor="@color/ui_text_dim"
            android:textSize="10.5sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/mouseTile"
                android:layout_width="0dp"
                android:layout_height="96dp"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_deck_tile"
                android:clickable="true"
                android:focusable="true"
                android:gravity="start"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingTop="14dp"
                android:paddingEnd="14dp"
                android:paddingBottom="12dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@string/apps_mouse"
                    android:src="@drawable/ic_mouse"
                    android:tint="@color/ui_accent" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="bottom"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/apps_mouse"
                        android:textColor="@color/ui_text"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/keyboardTile"
                android:layout_width="0dp"
                android:layout_height="96dp"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_deck_tile"
                android:clickable="true"
                android:focusable="true"
                android:gravity="start"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingTop="14dp"
                android:paddingEnd="14dp"
                android:paddingBottom="12dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@string/apps_keyboard"
                    android:src="@drawable/ic_keyboard"
                    android:tint="@color/ui_accent" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="bottom"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/apps_keyboard"
                        android:textColor="@color/ui_text"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/gamepadTile"
                android:layout_width="0dp"
                android:layout_height="96dp"
                android:layout_marginEnd="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_deck_tile"
                android:clickable="true"
                android:focusable="true"
                android:gravity="start"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingTop="14dp"
                android:paddingEnd="14dp"
                android:paddingBottom="12dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@string/apps_gamepad"
                    android:src="@drawable/ic_gamepad"
                    android:tint="@color/ui_accent" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="bottom"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/apps_gamepad"
                        android:textColor="@color/ui_text"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/screenTile"
                android:layout_width="0dp"
                android:layout_height="96dp"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:background="@drawable/bg_deck_tile"
                android:clickable="true"
                android:focusable="true"
                android:gravity="start"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingTop="14dp"
                android:paddingEnd="14dp"
                android:paddingBottom="12dp">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@string/apps_screen"
                    android:src="@drawable/ic_screen"
                    android:tint="@color/ui_accent" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:gravity="bottom"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/apps_screen"
                        android:textColor="@color/ui_text"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/appsHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="10dp"
            android:text="@string/apps_hint"
            android:textColor="@color/ui_text_dim"
            android:textSize="11.5sp" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Footer -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="22dp"
            android:background="@color/ui_card_stroke" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/developed_by"
                    android:textColor="@color/ui_text_muted"
                    android:textSize="12.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:fontFamily="monospace"
                    android:text="@string/version_label"
                    android:textColor="@color/ui_text_dim"
                    android:textSize="10sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/instagramButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_social"
                android:contentDescription="@string/social_instagram"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_instagram" />

            <ImageButton
                android:id="@+id/githubButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_social"
                android:contentDescription="@string/social_github"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_github" />

            <ImageButton
                android:id="@+id/linkedinButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_social"
                android:contentDescription="@string/social_linkedin"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_linkedin" />

            <ImageButton
                android:id="@+id/emailButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_social"
                android:contentDescription="@string/social_email"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_email" />

            <ImageButton
                android:id="@+id/patreonButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_social"
                android:contentDescription="@string/social_patreon"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_patreon" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
