<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_bg"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="18dp"
    android:paddingBottom="20dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:contentDescription="@string/mouse_title"
            android:src="@drawable/ic_mouse"
            android:tint="@color/ui_text_muted" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:text="@string/mouse_title"
            android:textColor="@color/ui_text"
            android:textSize="19sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/closeButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:padding="10dp"
            android:text="@string/mouse_close"
            android:textColor="@color/ui_accent"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/mouse_hint"
        android:textColor="@color/ui_text_dim"
        android:textSize="12sp" />

    <!-- Touch surface -->
    <View
        android:id="@+id/touchpad"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:layout_weight="1"
        android:background="@drawable/bg_touchpad" />

    <!-- Left click, scroll, right click -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="112dp"
        android:layout_marginTop="14dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/leftButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_touch_button"
            android:fontFamily="sans-serif-medium"
            android:stateListAnimator="@null"
            android:text="@string/mouse_left"
            android:textAllCaps="false"
            android:textColor="@color/ui_text"
            android:textSize="15sp" />

        <FrameLayout
            android:id="@+id/scrollStrip"
            android:layout_width="64dp"
            android:layout_height="match_parent"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_scroll_strip">

            <View
                android:id="@+id/scrollThumb"
                android:layout_width="30dp"
                android:layout_height="60dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_scroll_thumb" />
        </FrameLayout>

        <Button
            android:id="@+id/rightButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_touch_button"
            android:fontFamily="sans-serif-medium"
            android:stateListAnimator="@null"
            android:text="@string/mouse_right"
            android:textAllCaps="false"
            android:textColor="@color/ui_text"
            android:textSize="15sp" />
    </LinearLayout>
</LinearLayout>
