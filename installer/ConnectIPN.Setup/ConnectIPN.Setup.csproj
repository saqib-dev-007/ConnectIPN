<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ConnectIPN-Setup</AssemblyName>
    <RootNamespace>ConnectIPN.Setup</RootNamespace>
    <ApplicationIcon>..\..\windows\ConnectIPN.Desktop\Assets\app.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <PayloadZip Condition="'$(PayloadZip)' == ''">$(MSBuildThisFileDirectory)..\..\.tmp\payload.zip</PayloadZip>
    <AppVersion Condition="'$(AppVersion)' == ''">1.0</AppVersion>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="$(PayloadZip)" LogicalName="payload.zip" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>AppVersion</_Parameter1>
      <_Parameter2>$(AppVersion)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <Resource Include="..\..\windows\ConnectIPN.Desktop\Assets\app.ico" Link="Assets\app.ico" />
    <Resource Include="..\..\windows\ConnectIPN.Desktop\Assets\logo.png" Link="Assets\logo.png" />
  </ItemGroup>

</Project>
