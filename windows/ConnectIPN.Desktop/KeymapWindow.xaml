<Window x:Class="ConnectIPN.KeymapWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ConnectIPN â€” Key mapping"
        Width="520" Height="840" MinWidth="440" MinHeight="640"
        Background="#05070A"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True">

    <Window.Resources>
        <SolidColorBrush x:Key="Muted" Color="#7E938F" />
        <SolidColorBrush x:Key="Dim" Color="#4D5D5A" />
        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Background" Value="#0F1417" />
            <Setter Property="Foreground" Value="#E8F1EE" />
            <Setter Property="BorderBrush" Value="#1E292E" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#161D1F" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#2E3A38" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
            <Setter Property="Foreground" Value="#052E28" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#1CC9B0" Offset="0" />
                        <GradientStop Color="#5EEAD4" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#0B0F12" BorderBrush="#12181A" BorderThickness="0,0,0,1" Padding="12,8">
            <DockPanel>
                <TextBlock x:Name="StatusText" DockPanel.Dock="Right" Text=""
                           Foreground="{StaticResource Muted}" FontSize="11" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource ToolButton}" Content="+ Button" Margin="0,0,6,0" Click="AddButton_Click" />
                    <Button Style="{StaticResource ToolButton}" Content="+ Joystick" Margin="0,0,6,0" Click="AddStick_Click" />
                    <Button Style="{StaticResource ToolButton}" Content="+ Look" Margin="0,0,6,0" Click="AddLook_Click" />
                    <Button Style="{StaticResource ToolButton}" Content="Clear" Margin="0,0,12,0" Click="Clear_Click" />
                    <Button Style="{StaticResource AccentButton}" Content="Send to phone" Click="Send_Click" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="1" Background="#0B0F12" Padding="14">
            <Viewbox Stretch="Uniform">
                <Border Width="360" Height="720" Background="#0D1113"
                        BorderBrush="#1E2725" BorderThickness="1" CornerRadius="18" ClipToBounds="True">
                    <Canvas x:Name="Board" Width="360" Height="720" Background="#0B0E10" />
                </Border>
            </Viewbox>
        </Border>

        <Border Grid.Row="2" Background="#0B0F12" BorderBrush="#12181A" BorderThickness="0,1,0,0" Padding="14,8">
            <TextBlock Text="Drag to place Â· right-click to remove Â· Send pushes the layout to the phone"
                       Foreground="{StaticResource Dim}" FontSize="11" />
        </Border>
    </Grid>
</Window>
