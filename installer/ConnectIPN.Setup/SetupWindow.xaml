        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Background" Value="#141A23" />
            <Setter Property="Foreground" Value="#C9D2E2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                BorderBrush="#212936" BorderThickness="1" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#1D2531" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="38" />
            <Setter Property="MinWidth" Value="112" />
            <Setter Property="Background" Value="#3B82F6" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#2F73E8" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#171D27" />
            <Setter Property="Foreground" Value="#C9D2E2" />
            <Setter Property="FontWeight" Value="Normal" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#C9D2E2" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#E8EBF2" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="CaretBrush" Value="#E8EBF2" />
        </Style>
    </Window.Resources>

    <Border Background="#0B0E13" Padding="26">
        <StackPanel>
            <!-- Header -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image Grid.Column="0" Width="56" Height="56" Source="Assets/logo.png" />
                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="ConnectIPN" FontSize="23" FontWeight="Bold" />
                    <TextBlock x:Name="VersionText" Text="Version 1.0"
                               Foreground="#8C95A8" FontSize="12" Margin="0,3,0,0" />
                </StackPanel>
            </Grid>

            <TextBlock Text="Turns your Android phone into a drive letter on this PC, over plain Wi-Fi."
                       Foreground="#8C95A8" FontSize="12.5" TextWrapping="Wrap" Margin="0,14,0,0" />

            <!-- Developer -->
            <Border Background="#11151C" BorderBrush="#1D2430" BorderThickness="1" CornerRadius="14"
                    Padding="16" Margin="0,18,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="DEVELOPER" FontSize="10" FontWeight="SemiBold" Foreground="#8C95A8" />
                        <TextBlock Text="Saqib Mengal" FontSize="14" FontWeight="SemiBold" Margin="0,4,0,0" />
                        <TextBlock Text="saqibmengl7@gmail.com" FontSize="11.5" Foreground="#7E8AA0" Margin="0,2,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource IconButton}" Click="Instagram_Click" ToolTip="Instagram" Margin="0,0,6,0">
                            <Path Data="{StaticResource InstagramIcon}" Fill="#C9D2E2" Stretch="Uniform" Width="13" Height="13" />
                        </Button>
                        <Button Style="{StaticResource IconButton}" Click="Github_Click" ToolTip="GitHub" Margin="0,0,6,0">
                            <Path Data="{StaticResource GithubIcon}" Fill="#C9D2E2" Stretch="Uniform" Width="13" Height="13" />
                        </Button>
                        <Button Style="{StaticResource IconButton}" Click="Linkedin_Click" ToolTip="LinkedIn" Margin="0,0,6,0">
                            <Path Data="{StaticResource LinkedinIcon}" Fill="#C9D2E2" Stretch="Uniform" Width="13" Height="13" />
                        </Button>
                        <Button Style="{StaticResource IconButton}" Click="Email_Click" ToolTip="Email">
                            <Path Data="{StaticResource EmailIcon}" Fill="#C9D2E2" Stretch="Uniform" Width="13" Height="13" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Install location -->
            <TextBlock Text="INSTALL LOCATION" FontSize="10" FontWeight="SemiBold" Foreground="#8C95A8"
                       Margin="0,20,0,7" />
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Height="38" Background="#171D27" BorderBrush="#232B38"
                        BorderThickness="1" CornerRadius="9" Padding="10,0">
                    <TextBox x:Name="PathBox" Background="Transparent" BorderThickness="0" />
                </Border>
                <Button Grid.Column="1" Content="Browse…" Style="{StaticResource SecondaryButton}"
                        Height="38" MinWidth="92" Margin="8,0,0,0" Click="Browse_Click" />
            </Grid>

            <!-- Options -->
            <StackPanel Margin="0,18,0,0">
                <CheckBox x:Name="DesktopShortcutCheck" Content="Create a desktop shortcut" IsChecked="True" />
                <CheckBox x:Name="StartupCheck" Content="Start ConnectIPN when Windows starts (runs in the notification area)" IsChecked="True" />
            </StackPanel>

            <!-- Progress -->
            <ProgressBar x:Name="Progress" Height="4" Margin="0,10,0,0" Minimum="0" Maximum="100"
                         Foreground="#3B82F6" Background="#1B222C" BorderThickness="0" Visibility="Hidden" />
            <TextBlock x:Name="StatusText" Text="" Foreground="#8C95A8" FontSize="12"
                       Margin="0,12,0,0" TextWrapping="Wrap" MinHeight="18" />

            <!-- Actions -->
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox x:Name="LaunchCheck" Grid.Column="0" Content="Launch ConnectIPN" IsChecked="True"
                          VerticalAlignment="Center" Margin="0" Visibility="Collapsed" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button x:Name="CancelButton" Content="Cancel" Style="{StaticResource SecondaryButton}"
                            Margin="0,0,8,0" Click="Cancel_Click" />
                    <Button x:Name="InstallButton" Content="Install" Style="{StaticResource PrimaryButton}"
                            Click="Install_Click" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</Window>
