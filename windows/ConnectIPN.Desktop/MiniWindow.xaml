<Window x:Class="ConnectIPN.MiniWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ConnectIPN"
        Width="352" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        FontFamily="Segoe UI" Foreground="#E8F1EE" UseLayoutRounding="True">

    <Window.Resources>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="40" />
            <Setter Property="Background" Value="#1CC9B0" />
            <Setter Property="Foreground" Value="#052E28" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#1CC9B0" Offset="0" />
                        <GradientStop Color="#5EEAD4" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="Background" Value="#0F1417" />
            <Setter Property="Foreground" Value="#C7D6D2" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                BorderBrush="#1E292E" BorderThickness="1" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#161D1F" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="#2E3A38" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseGlyph" TargetType="Button">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#7E938F" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#1E2725" />
                                <Setter Property="Foreground" Value="#E8F1EE" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Border Background="#0B0F12" BorderBrush="#1E2725" BorderThickness="1" CornerRadius="16">
            <Border.Effect>
                <DropShadowEffect BlurRadius="22" ShadowDepth="4" Direction="270" Opacity="0.45" Color="#000000" />
            </Border.Effect>

            <StackPanel Margin="18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Ellipse x:Name="StatusDot" Grid.Column="0" Width="9" Height="9" Fill="#FBBF24"
                             VerticalAlignment="Center" />
                    <TextBlock x:Name="StatusText" Grid.Column="1" Text="Waiting for phoneâ€¦"
                               FontSize="13.5" FontWeight="SemiBold" Margin="9,0,0,0"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <Button Grid.Column="2" Style="{StaticResource CloseGlyph}" Content="&#xE8BB;"
                            Click="Close_Click" ToolTip="Hide" />
                </Grid>

                <!-- Not connected: show the pairing code -->
                <StackPanel x:Name="PairPanel" Margin="0,14,0,0">
                    <Border Background="White" CornerRadius="12" Padding="10" HorizontalAlignment="Center">
                        <Image x:Name="QrImage" Width="188" Height="188"
                               RenderOptions.BitmapScalingMode="NearestNeighbor" />
                    </Border>
                    <TextBlock Text="Scan this code with the ConnectIPN app on your phone."
                               Foreground="#7E938F" FontSize="11.5" TextWrapping="Wrap"
                               TextAlignment="Center" Margin="6,12,6,0" LineHeight="16" />
                </StackPanel>

                <!-- Connected: show the phone and drive state -->
                <StackPanel x:Name="LinkPanel" Margin="0,14,0,0" Visibility="Collapsed">
                    <Border Background="#0F1417" BorderBrush="#1E2725" BorderThickness="1" CornerRadius="10"
                            Padding="12">
                        <StackPanel>
                            <TextBlock x:Name="DeviceText" Text="" Foreground="#C7D6D2" FontSize="12"
                                       TextWrapping="Wrap" />
                            <TextBlock x:Name="DriveText" Text="" Foreground="#7E938F" FontSize="11.5"
                                       Margin="0,6,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Button x:Name="MountButton" Style="{StaticResource PrimaryButton}" Content="Mount drive"
                        Margin="0,14,0,0" Click="Mount_Click" />

                <Button x:Name="DriveButton" Style="{StaticResource GhostButton}" Content="Open drive"
                        Margin="0,14,0,0" Visibility="Collapsed" Click="Drive_Click" />

                <Button x:Name="UnmountButton" Style="{StaticResource GhostButton}" Content="Unmount"
                        Margin="0,8,0,0" Visibility="Collapsed" Click="Unmount_Click" />

                <TextBlock x:Name="HintText" Text="" Foreground="#4D5D5A" FontSize="11"
                           TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0" />

                <Button Style="{StaticResource GhostButton}" Content="Open ConnectIPN"
                        Margin="0,12,0,0" Click="OpenApp_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
