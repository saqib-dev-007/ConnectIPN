<Window x:Class="ConnectIPN.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ConnectIPN" Height="720" Width="1000" MinHeight="660" MinWidth="900"
        Icon="Assets/app.ico"
        Background="#0B0E13" Foreground="#E8EBF2" FontFamily="Segoe UI"
        WindowStyle="None" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" CornerRadius="0"
                      GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="Card" Color="#11151C" />
        <SolidColorBrush x:Key="Stroke" Color="#1D2430" />
        <SolidColorBrush x:Key="Muted" Color="#8C95A8" />
        <SolidColorBrush x:Key="Dim" Color="#5F6878" />
        <SolidColorBrush x:Key="Accent" Color="#3B82F6" />

