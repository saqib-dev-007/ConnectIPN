        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ConnectIPN Setup" Width="620" SizeToContent="Height"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen"
        Background="#0B0E13" Foreground="#E8EBF2" FontFamily="Segoe UI"
