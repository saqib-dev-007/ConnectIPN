        <Geometry x:Key="LinkedinIcon">M20.447,20.452h-3.554v-5.569c0,-1.328 -0.027,-3.037 -1.852,-3.037 -1.853,0 -2.136,1.445 -2.136,2.939v5.667H9.351V9h3.414v1.561h0.046c0.477,-0.9 1.637,-1.85 3.37,-1.85 3.601,0 4.267,2.37 4.267,5.455v6.286zM5.337,7.433c-1.144,0 -2.063,-0.926 -2.063,-2.065 0,-1.138 0.92,-2.063 2.063,-2.063 1.14,0 2.064,0.925 2.064,2.063 0,1.139 -0.925,2.065 -2.064,2.065zM7.119,20.452H3.555V9h3.564v11.452zM22.225,0H1.771C0.792,0 0,0.774 0,1.729v20.542C0,23.227 0.792,24 1.771,24h20.451C23.2,24 24,23.227 24,22.271V1.729C24,0.774 23.2,0 22.225,0z</Geometry>
        <Geometry x:Key="PatreonIcon">M22.957,7.21c-0.004,-3.064 -2.391,-5.576 -5.191,-6.482 -3.478,-1.125 -8.064,-0.962 -11.384,0.604C2.357,3.231 1.093,7.391 1.046,11.54c-0.039,3.411 0.302,12.396 5.369,12.46 3.765,0.047 4.326,-4.804 6.068,-7.141 1.24,-1.662 2.836,-2.132 4.801,-2.618 3.376,-0.836 5.678,-3.501 5.673,-7.031Z</Geometry>
        <Geometry x:Key="EmailIcon">M4.5,4h15A2.5,2.5 0,0 1,22 6.5v11a2.5,2.5 0,0 1,-2.5 2.5h-15A2.5,2.5 0,0 1,2 17.5v-11A2.5,2.5 0,0 1,4.5 4zM4.2,6.1l7.3,5.2a1,1 0,0 0,1 0l7.3,-5.2zM20,8.2l-7.1,5a3,3 0,0 1,-3.8 0l-7.1,-5v9.3a0.5,0.5 0,0 0,0.5 0.5h15a0.5,0.5 0,0 0,0.5 -0.5z</Geometry>

        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Card}" />
            <Setter Property="BorderBrush" Value="{StaticResource Stroke}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="20" />
        </Style>

        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Dim}" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        </Style>

        <Style x:Key="TitleButton" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#7E938F" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#10161A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource TitleButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#C9392C" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Background" Value="#0F1417" />
            <Setter Property="Foreground" Value="#7E938F" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                BorderBrush="#1E292E" BorderThickness="1" CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#141B1F" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="#2A3A38" />
                                <Setter Property="Foreground" Value="#5EEAD4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SideButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource Field}" />
            <Setter Property="Foreground" Value="#C9D4D0" />
            <Setter Property="BorderBrush" Value="#1E292E" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#141B1F" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="#2A3A38" />
                                <Setter Property="Foreground" Value="#E8F1EE" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary action: liquid mint -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="#04241F" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="18,9" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" CornerRadius="9" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.92" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Opacity" Value="0.78" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#1CC9B0" Offset="0" />
                        <GradientStop Color="#5EEAD4" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#E8F1EE" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#16221F" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#123A34" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource Field}" />
            <Setter Property="Foreground" Value="#E8F1EE" />
            <Setter Property="BorderBrush" Value="#1E292E" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                          Background="{TemplateBinding Background}"
                                          BorderBrush="{TemplateBinding BorderBrush}"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="1" CornerRadius="9">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="24" />
                                                </Grid.ColumnDefinitions>
                                                <Path Grid.Column="1" Data="M 0 0 L 4 4 L 8 0"
                                                      Stroke="#7E938F" StrokeThickness="1.6"
                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Chrome" Property="Background" Value="#141B1F" />
                                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#2A3A38" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter x:Name="Selection" IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                              Margin="12,0,28,0"
                                              VerticalAlignment="Center" HorizontalAlignment="Left" />

                            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                                   IsOpen="{TemplateBinding IsDropDownOpen}" StaysOpen="False"
                                   PopupAnimation="Fade" Focusable="False">
                                <Border Background="#0C1013" BorderBrush="#1E292E" BorderThickness="1"
                                        CornerRadius="9" Margin="0,4,0,0" Padding="4"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootBorder" Background="#05070A">
        <Grid x:Name="RootGrid">
            <Grid.RowDefinitions>
                <RowDefinition Height="40" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Grid Grid.Row="0" Background="#05070A">
                <Border VerticalAlignment="Bottom" Height="1" Background="#10161A" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center"
                            Margin="16,0,0,0" IsHitTestVisible="False">
                    <Border Width="22" Height="22" CornerRadius="7" Background="#10161A">
                        <Image Source="Assets/logo.png" Width="16" Height="16"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <TextBlock Text="ConnectIPN" FontSize="12" FontWeight="SemiBold"
                               Foreground="#7E938F" Margin="9,0,0,0" VerticalAlignment="Center" />
                    <TextBlock Text="/ operation deck" FontFamily="Consolas" FontSize="10.5"
                               Foreground="#3A4643" Margin="8,1,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="MinimizeButton" Style="{StaticResource TitleButton}"
                            Content="&#xE921;" Click="MinimizeButton_Click" ToolTip="Minimize" />
                    <Button x:Name="MaximizeButton" Style="{StaticResource TitleButton}"
                            Content="&#xE922;" Click="MaximizeButton_Click" ToolTip="Maximize" />
                    <Button x:Name="CloseButton" Style="{StaticResource CloseButton}"
                            Content="&#xE8BB;" Click="CloseButton_Click" ToolTip="Close" />
                </StackPanel>
            </Grid>

            <!-- Deck -->
            <Grid Grid.Row="1" Margin="26,20,26,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="352" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Left column: the link, visualized -->
                <StackPanel Grid.Column="0">
                    <Border Style="{StaticResource CardBorder}">
                        <StackPanel x:Name="LinkCard">
                            <!-- Live status read-out -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid Width="18" Height="18" VerticalAlignment="Center">
                                    <Ellipse x:Name="StatusGlow" Fill="#2DD4BF" Opacity="0" />
                                    <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="#FBBF24" />
                                    <Ellipse x:Name="StatusRing" Width="18" Height="18"
                                             Stroke="#2DD4BF" StrokeThickness="1" Opacity="0.35" />
                                </Grid>
                                <StackPanel Grid.Column="1" Margin="11,0,0,0">
                                    <TextBlock x:Name="StatusText" Text="Starting…" FontSize="15.5" FontWeight="SemiBold" />
                                    <TextBlock x:Name="DeviceText" Text="" Foreground="{StaticResource Muted}"
                                               FontSize="11.5" Margin="0,3,0,0"
                                               TextWrapping="Wrap" FontFamily="Segoe UI" />
                                </StackPanel>
                            </Grid>

                            <!-- USB: only offered while a cable-attached phone is visible -->
                            <StackPanel x:Name="UsbPanel" Visibility="Collapsed" Margin="0,14,0,0">
                                <WrapPanel>
                                    <Button x:Name="UsbButton" Content="Connect via USB"
                                            Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"
                                            Click="UsbButton_Click" />
                                    <TextBlock x:Name="UsbBadge" Text="USB" VerticalAlignment="Center"
                                               Foreground="{StaticResource Dim}" FontSize="11.5"
                                               FontFamily="Consolas" />
                                </WrapPanel>
                                <TextBlock x:Name="UsbHint" Foreground="{StaticResource Dim}" FontSize="11.5"
                                           Margin="0,8,0,0" TextWrapping="Wrap" FontFamily="Consolas" />
                            </StackPanel>

                            <Border Height="1" Background="{StaticResource Hairline}" Margin="0,16,0,16" />

                            <!-- QR with aquan brackets -->
                            <Grid HorizontalAlignment="Center">
                                <Grid Width="248" Height="248">
                                    <Border Background="White" CornerRadius="12" BorderBrush="#1E292E" BorderThickness="1" />
                                    <Image x:Name="QrImage" Width="216" Height="216"
                                           RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                </Grid>
                                <!-- brackets -->
                                <Canvas Width="250" Height="250" IsHitTestVisible="False">
                                    <Path Stroke="#2DD4BF" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Data="M 6 34 L 6 6 L 34 6" />
                                    <Path Stroke="#2DD4BF" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Data="M 216 6 L 244 6 L 244 34" />
                                    <Path Stroke="#2DD4BF" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Data="M 244 216 L 244 244 L 216 244" />
                                    <Path Stroke="#2DD4BF" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Data="M 34 244 L 6 244 L 6 216" />
                                </Canvas>
                            </Grid>

                            <TextBlock Text="SCAN ONCE — AUTORECONNECTS" Style="{StaticResource Caption}"
                                       HorizontalAlignment="Center" Margin="0,16,0,0" Opacity="0.8" />

                            <!-- mono meta -->
                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="66" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="HOST" Style="{StaticResource Caption}" Margin="0,0,0,10" />
                                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="HostText" Text="-" Margin="0,0,0,10" FontFamily="Consolas" FontSize="12.5" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="PORT" Style="{StaticResource Caption}" Margin="0,0,0,10" />
                                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="PortText" Text="-" Margin="0,0,0,10" FontFamily="Consolas" FontSize="12.5" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Text="TOKEN" Style="{StaticResource Caption}" Margin="0,0,0,10" />
                                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TokenText" Text="-" FontFamily="Consolas" FontSize="12.5" Foreground="#7E938F" Margin="0,0,0,10" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Text="ADAPTER" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                <ComboBox Grid.Row="3" Grid.Column="1" x:Name="IpCombo" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Keep this window open while you connect."
                               Foreground="{StaticResource Dim}" FontSize="11"
                               TextWrapping="Wrap" Margin="6,12,6,0" />
                </StackPanel>

                <!-- Right column: commands -->
                <StackPanel Grid.Column="2">
                    <TextBlock Text="COMMAND SURFACE" Style="{StaticResource Caption}"
                               Margin="2,4,0,12" />
                    <Border x:Name="CommandsCard" Style="{StaticResource CardBorder}" Padding="22,20">
                        <StackPanel>
                            <!-- NVD row -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="NETWORK DRIVE" Style="{StaticResource Caption}" />
                                    <TextBlock Text="Mount your phone's storage as a Windows drive letter."
                                               Foreground="{StaticResource Muted}" FontSize="12.5"
                                               TextWrapping="Wrap" Margin="0,8,16,8" />
                                    <WrapPanel>
                                        <ComboBox x:Name="DriveCombo" Width="94" Margin="0,0,10,8" />
                                        <Button x:Name="MountButton" Content="Mount drive" Style="{StaticResource PrimaryButton}"
                                                Margin="0,0,8,8" IsEnabled="False" Click="MountButton_Click" />
                                        <Button x:Name="UnmountButton" Content="Unmount" Margin="0,0,8,8"
                                                IsEnabled="False" Click="UnmountButton_Click"
                                                Style="{StaticResource SideButton}" />
                                        <Button x:Name="OpenButton" Content="Open in Explorer" Margin="0,0,0,8"
                                                IsEnabled="False" Click="OpenButton_Click"
                                                Style="{StaticResource SideButton}" />
                                    </WrapPanel>
                                    <TextBlock x:Name="DriveHint" Text="Connect your phone to enable mounting."
                                               Foreground="{StaticResource Dim}" FontSize="11.5" Margin="0,6,0,0"
                                               TextWrapping="Wrap" FontFamily="Consolas" />
                                </StackPanel>
                            </Grid>

                            <Border Height="1" Background="{StaticResource Hairline}" Margin="0,18" />

                            <!-- Screen row -->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="SCREEN" Style="{StaticResource Caption}" />
                                    <TextBlock Text="Mirror this device's screen or open the PC screen on your phone."
                                               Foreground="{StaticResource Muted}" FontSize="12.5"
                                               TextWrapping="Wrap" Margin="0,8,16,8" />
                                    <WrapPanel>
                                        <Button x:Name="PhoneScreenButton" Content="Phone screen" Style="{StaticResource PrimaryButton}"
                                                Margin="0,0,8,8" IsEnabled="False" Click="PhoneScreenButton_Click" />
                                        <Button x:Name="KeymapButton" Content="Key mapping" Margin="0,0,0,8"
                                                Click="KeymapButton_Click" Style="{StaticResource SideButton}" />
                                    </WrapPanel>
                                    <TextBlock x:Name="ScreenHint" Text="Connect your phone to mirror screens."
                                               Foreground="{StaticResource Dim}" FontSize="11.5" Margin="0,6,0,4"
                                               TextWrapping="Wrap" FontFamily="Consolas" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- System / drivers -->
                    <Border x:Name="DriversCard" Style="{StaticResource CardBorder}"
                            Padding="22,16" Margin="0,14,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0">
                                <TextBlock Text="SYSTEM" Style="{StaticResource Caption}" />
                                <TextBlock Text="Check drivers again" Foreground="{StaticResource Muted}"
                                           FontSize="12.5" Margin="0,6,12,0" />
                            </StackPanel>
                            <Button x:Name="RecheckDrivers" Grid.Row="0" Grid.Column="1" Content="Recheck"
                                    Style="{StaticResource SideButton}" Click="RecheckDrivers_Click"
                                    ToolTip="Detect drivers again after installing" />

                            <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4" Height="1"
                                    Background="{StaticResource Hairline}" Margin="0,12" />

                            <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6" Fill="#34D399" Opacity="0.8"
                                             VerticalAlignment="Center" Margin="0,0,7,0" />
                                    <TextBlock Text="WinFsp" FontSize="12.5" FontWeight="SemiBold" />
                                </StackPanel>
                                <TextBlock x:Name="WinFspStatus" Text="Checking…" Foreground="{StaticResource Muted}"
                                           FontSize="11.5" TextWrapping="Wrap" Margin="13,2,0,0" />
                            </StackPanel>
                            <Button x:Name="WinFspButton" Grid.Row="2" Grid.Column="1" Content="Download"
                                    Style="{StaticResource SideButton}" VerticalAlignment="Center"
                                    Margin="0,0,8,0" Click="GetWinFsp_Click" />

                            <StackPanel Grid.Row="2" Grid.Column="2" Margin="10,0,10,0">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6" Fill="#34D399" Opacity="0.8"
                                             VerticalAlignment="Center" Margin="0,0,7,0" />
                                    <TextBlock Text="ViGEmBus" FontSize="12.5" FontWeight="SemiBold" />
                                </StackPanel>
                                <TextBlock x:Name="ViGEmStatus" Text="Checking…" Foreground="{StaticResource Muted}"
                                           FontSize="11.5" TextWrapping="Wrap" Margin="13,2,0,0" />
                            </StackPanel>
                            <Button x:Name="ViGEmButton" Grid.Row="2" Grid.Column="3" Content="Download"
                                    Style="{StaticResource SideButton}" VerticalAlignment="Center" Click="GetViGEm_Click" />
                        </Grid>
                    </Border>

                    <!-- Activity: the deck's black-box recorder -->
                    <Border x:Name="LogCard" Style="{StaticResource CardBorder}" Padding="20,14" Margin="0,14,0,0"
                            MinHeight="148">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="ACTIVITY LOG" Style="{StaticResource Caption}" Margin="2,0,0,8" />
                            <ListBox x:Name="LogList" Background="Transparent" BorderThickness="0"
                                     Foreground="#7E938F" FontFamily="Consolas" FontSize="11.5"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     Padding="0">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="4,2" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <ContentPresenter />
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- Developer footer -->
            <Border Grid.Row="2" Background="#080C0F" BorderBrush="#10161A" BorderThickness="0,1,0,0"
                    Padding="26,0">
                <Grid Height="54">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Developed by" Foreground="{StaticResource Dim}" FontSize="12"
                                   VerticalAlignment="Center" />
                        <TextBlock Text="Saqib Mengal" Foreground="#C9D4D0" FontSize="12" FontWeight="SemiBold"
                                   Margin="5,0,0,0" VerticalAlignment="Center" />
                        <TextBlock Text="/" Foreground="#2A3A38" FontFamily="Consolas" FontSize="11" Margin="10,0"
                                   VerticalAlignment="Center" />
                        <TextBlock x:Name="VersionText" Text="v2.0" Foreground="{StaticResource Dim}"
                                   FontFamily="Consolas" FontSize="11"
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="InstagramButton" Style="{StaticResource IconButton}"
                                Click="InstagramButton_Click" ToolTip="Instagram" Margin="0,0,7,0">
                            <Path Data="{StaticResource InstagramIcon}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Stretch="Uniform" Width="14" Height="14" />
                        </Button>
                        <Button x:Name="GithubButton" Style="{StaticResource IconButton}"
                                Click="GithubButton_Click" ToolTip="GitHub" Margin="0,0,7,0">
                            <Path Data="{StaticResource GithubIcon}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Stretch="Uniform" Width="14" Height="14" />
                        </Button>
                        <Button x:Name="LinkedinButton" Style="{StaticResource IconButton}"
                                Click="LinkedinButton_Click" ToolTip="LinkedIn" Margin="0,0,7,0">
                            <Path Data="{StaticResource LinkedinIcon}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Stretch="Uniform" Width="14" Height="14" />
                        </Button>
                        <Button x:Name="EmailButton" Style="{StaticResource IconButton}"
                                Click="EmailButton_Click" ToolTip="Email">
                            <Path Data="{StaticResource EmailIcon}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Stretch="Uniform" Width="14" Height="14" />
                        </Button>
                        <Button x:Name="PatreonButton" Style="{StaticResource IconButton}"
                                Click="PatreonButton_Click" ToolTip="Patreon" Margin="7,0,0,0">
                            <Path Data="{StaticResource PatreonIcon}" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  Stretch="Uniform" Width="14" Height="14" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
