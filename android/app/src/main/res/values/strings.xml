    <!-- Control access, in plain language -->
    <string name="screen_access_title">Control this phone from your PC</string>
    <string name="screen_access_why">Android does not let an ordinary app tap on other apps. It only allows it through an Accessibility service, so ConnectIPN needs that switch turned on once. Until then you can still see this phone on the PC, but clicks do nothing.</string>
    <string name="screen_access_line_control">Taps, swipes and typing from the PC — %1$s</string>
    <string name="screen_access_line_overlay">Key mapping drawn over games — %1$s</string>
    <string name="screen_access_help_title">Turn on PC control</string>
    <string name="screen_access_help_body">1. Tap "Open settings" below.\n\n2. On that page tap "Installed services" (on some phones it is "Downloaded apps" or "Downloaded services").\n\n3. Tap ConnectIPN, then turn its switch on and confirm with Allow.\n\n4. Press back until you are here again. The line above changes to "on" and the PC can tap this screen.\n\nThe service is only used to send taps and key presses. ConnectIPN does not read your screen content with it, and nothing leaves your own network.</string>
    <string name="screen_access_help_open">Open settings</string>
    <string name="screen_access_help_later">Not now</string>
    <string name="screen_access_overlay_title">Allow drawing over games</string>
    <string name="screen_access_overlay_body">This is a different switch. It lets ConnectIPN draw the key-mapping buttons on top of a game while you play. It is only needed for key mapping, not for PC control.\n\n1. Tap "Open settings" below.\n\n2. Find ConnectIPN in the list.\n\n3. Turn on "Permit drawing over other apps".</string>

