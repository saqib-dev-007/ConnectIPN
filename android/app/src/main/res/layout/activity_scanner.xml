<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlays"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_bg_deep">

    <com.journeyapps.barcodescanner.DecoratedBarcodeView
        android:id="@+id/scanner"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- ScanOverlay (animated reticle) is added into this root at runtime,
         above the camera but below the chrome. -->

    <ImageButton
        android:id="@+id/backButton"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_alignParentStart="true"
        android:layout_marginStart="16dp"
        android:layout_marginTop="20dp"
        android:background="@drawable/bg_social"
        android:contentDescription="@string/back"
        android:padding="11dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_back" />

    <TextView
        android:id="@+id/scannerTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_toEndOf="@id/backButton"
        android:layout_marginStart="14dp"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.18"
        android:text="@string/scan_title"
        android:textAllCaps="true"
        android:textColor="@color/ui_text"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/scannerHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/scannerTitle"
        android:layout_alignStart="@id/scannerTitle"
        android:layout_marginTop="1dp"
        android:fontFamily="monospace"
        android:text="@string/scan_hint"
        android:textColor="@color/ui_text_dim"
        android:textSize="10sp" />

    <TextView
        android:id="@+id/scannerPrompt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="42dp"
        android:layout_centerHorizontal="true"
        android:alpha="0.9"
        android:gravity="center"
        android:text="@string/scan_prompt"
        android:textColor="@color/ui_text_muted"
        android:textSize="12.5sp" />

    <ImageButton
        android:id="@+id/torchButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_above="@id/scannerPrompt"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="14dp"
        android:alpha="0.6"
        android:background="@drawable/bg_social"
        android:contentDescription="@string/torch"
        android:padding="12dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_torch" />
</RelativeLayout>
