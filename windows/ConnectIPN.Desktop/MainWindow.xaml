<Window x:Class="ConnectIPN.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ConnectIPN" Height="740" Width="1060" MinHeight="680" MinWidth="940"
        Icon="Assets/app.ico"
        Background="#05070A" Foreground="#E8F1EE" FontFamily="Segoe UI"
        WindowStyle="None" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" SnapsToDevicePixels="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" CornerRadius="0"
                      GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="Card" Color="#0B0F12" />
        <SolidColorBrush x:Key="Stroke" Color="#171E22" />
        <SolidColorBrush x:Key="Hairline" Color="#10161A" />
        <SolidColorBrush x:Key="Muted" Color="#7E938F" />
        <SolidColorBrush x:Key="Dim" Color="#4D5D5A" />
        <SolidColorBrush x:Key="Accent" Color="#2DD4BF" />
        <SolidColorBrush x:Key="Highlight" Color="#5EEAD4" />
        <SolidColorBrush x:Key="Field" Color="#0F1417" />

