<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="KeymapTool">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:background">@drawable/bg_button_secondary</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/ui_text</item>
        <item name="android:textSize">12.5sp</item>
    </style>

    <style name="Theme.ConnectIPN" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/ui_bg</item>
        <item name="android:statusBarColor">@color/ui_bg</item>
        <item name="android:navigationBarColor">@color/ui_bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <!-- Screen-to-screen motion: slide up + fade, decelerate in, accelerate out. -->
        <item name="android:windowAnimationStyle">@style/WindowMotion</item>
        <item name="colorAccent">@color/ui_accent</item>
        <item name="colorPrimary">@color/ui_accent</item>
        <item name="colorPrimaryDark">@color/ui_bg</item>
    </style>

    <style name="WindowMotion">
        <item name="android:activityOpenEnterAnimation">@anim/window_enter</item>
        <item name="android:activityOpenExitAnimation">@anim/window_exit</item>
        <item name="android:activityCloseEnterAnimation">@anim/window_enter</item>
        <item name="android:activityCloseExitAnimation">@anim/window_exit</item>
    </style>
</resources>
