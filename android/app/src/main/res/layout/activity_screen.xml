<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ui_bg"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="18dp"
        android:paddingBottom="24dp">

        <!-- Header strip -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/backButton"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_row"
                android:contentDescription="@string/back"
                android:padding="11dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_back" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="13dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.16"
                android:text="@string/screen_title"
                android:textAllCaps="true"
                android:textColor="@color/ui_text"
                android:textSize="15sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:letterSpacing="0.06"
                android:text="@string/version_label"
                android:textColor="@color/ui_text_dim"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Live status: mini radar + line -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_panel"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <com.connectipn.RadarView
                android:id="@+id/screenRadar"
                android:layout_width="40dp"
                android:layout_height="40dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="3dp"
                    android:text="@string/screen_status_idle"
                    android:textColor="@color/ui_text"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/statsText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:fontFamily="monospace"
                    android:textColor="@color/ui_text_muted"
                    android:textSize="11sp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <!-- Start command -->
        <Button
            android:id="@+id/startButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_primary"
            android:fontFamily="sans-serif-medium"
            android:stateListAnimator="@null"
            android:text="@string/screen_start"
            android:textAllCaps="false"
            android:textColor="@color/ui_on_accent"
            android:textSize="15sp" />

        <!-- Options list -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="20dp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.14"
            android:text="@string/screen_quality_title"
            android:textAllCaps="true"
            android:textColor="@color/ui_text_dim"
            android:textSize="10.5sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/resolutionButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_row"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:stateListAnimator="@null"
                    android:text="@string/screen_resolution"
                    android:textAllCaps="false"
                    android:textColor="@color/ui_text"
                    android:textSize="12.5sp" />

                <Button
                    android:id="@+id/fpsButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_row"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:stateListAnimator="@null"
                    android:text="@string/screen_fps"
                    android:textAllCaps="false"
                    android:textColor="@color/ui_text"
                    android:textSize="12.5sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/qualityButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_row"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:stateListAnimator="@null"
                    android:text="@string/screen_quality"
                    android:textAllCaps="false"
                    android:textColor="@color/ui_text"
                    android:textSize="12.5sp" />

                <Button
                    android:id="@+id/orientationButton"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_row"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:stateListAnimator="@null"
                    android:text="@string/screen_orientation"
                    android:textAllCaps="false"
                    android:textColor="@color/ui_text"
                    android:textSize="12.5sp" />
            </LinearLayout>

            <Button
                android:id="@+id/aspectButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_row"
                android:fontFamily="monospace"
                android:gravity="center"
                android:stateListAnimator="@null"
                android:text="@string/screen_aspect"
                android:textAllCaps="false"
                android:textColor="@color/ui_text"
                android:textSize="12.5sp" />
        </LinearLayout>

        <!-- Capture switches -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_panel"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="14dp"
            android:paddingBottom="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/screen_audio"
                    android:textColor="@color/ui_text"
                    android:textSize="14sp" />

                <Switch
                    android:id="@+id/audioSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:background="@color/ui_card_stroke" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/screen_lock"
                    android:textColor="@color/ui_text"
                    android:textSize="14sp" />

                <Switch
                    android:id="@+id/lockSwitch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>

        <!-- Control access -->
        <TextView
            android:id="@+id/accessTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="20dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/screen_access_title"
            android:textColor="@color/ui_text"
            android:textSize="13.5sp" />

        <TextView
            android:id="@+id/accessWhy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="6dp"
            android:lineSpacingExtra="3dp"
            android:text="@string/screen_access_why"
            android:textColor="@color/ui_text_muted"
            android:textSize="11.5sp" />

        <TextView
            android:id="@+id/accessState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="10dp"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/ui_text_muted"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/keymapButton"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_row"
                android:fontFamily="sans-serif-medium"
                android:stateListAnimator="@null"
                android:text="@string/screen_keymap"
                android:textAllCaps="false"
                android:textColor="@color/ui_text_muted"
                android:textSize="12.5sp" />

            <Button
                android:id="@+id/accessButton"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:background="@drawable/bg_row"
                android:fontFamily="sans-serif-medium"
                android:stateListAnimator="@null"
                android:text="@string/screen_control_access"
                android:textAllCaps="false"
                android:textColor="@color/ui_text_muted"
                android:textSize="12.5sp" />
        </LinearLayout>

        <!-- PC screen -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="20dp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.14"
            android:text="@string/screen_pc_title"
            android:textAllCaps="true"
            android:textColor="@color/ui_text_dim"
            android:textSize="10.5sp" />

        <LinearLayout
            android:id="@+id/viewPcButton"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_row"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/screen_view_pc"
                android:textColor="@color/ui_text"
                android:textSize="14.5sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="&#8250;"
                android:textColor="@color/ui_text_dim"
                android:textSize="20sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/gamingButton"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/bg_row"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/screen_gaming"
                android:textColor="@color/ui_text"
                android:textSize="14.5sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="&#8250;"
                android:textColor="@color/ui_text_dim"
                android:textSize="20sp" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="14dp"
            android:lineSpacingExtra="3dp"
            android:text="@string/screen_hint"
            android:textColor="@color/ui_text_dim"
            android:textSize="11.5sp" />
    </LinearLayout>
</ScrollView>
