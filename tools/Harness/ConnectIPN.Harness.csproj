<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>ConnectIPN.Harness</AssemblyName>
    <RootNamespace>ConnectIPN.Harness</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Nefarius.ViGEm.Client" Version="1.21.256" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\windows\ConnectIPN.Desktop\Protocol\Protocol.cs" Link="Shared\Protocol.cs" />
    <Compile Include="..\..\windows\ConnectIPN.Desktop\Net\RemoteClient.cs" Link="Shared\RemoteClient.cs" />
    <Compile Include="..\..\windows\ConnectIPN.Desktop\Net\LinkServer.cs" Link="Shared\LinkServer.cs" />
    <Compile Include="..\..\windows\ConnectIPN.Desktop\Net\GamepadHost.cs" Link="Shared\GamepadHost.cs" />
    <Compile Include="..\..\windows\ConnectIPN.Desktop\Net\InputInjector.cs" Link="Shared\InputInjector.cs" />
  </ItemGroup>
</Project>
